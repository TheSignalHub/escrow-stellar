# Privy App ID — create a free app at https://privy.io/dashboard
# Copy this file to .env and fill in your values
VITE_PRIVY_APP_ID=your-privy-app-id-here

# DealEscrow contract address (set after deployment to Testnet)
VITE_DEAL_ESCROW_CONTRACT=CCUOZRSDISJOF66YPNEGY7FDH7WTUZHI5TB55F4MOGED2UEKZXYRP6AP

# Stellar network profile. Defaults in code preserve the SCF testnet demo.
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
VITE_FRIENDBOT_URL=https://friendbot.stellar.org

# Optional mainnet preset payout addresses for reviewer smoke deals. These are
# public keys only; never put private keys in VITE_ envs.
VITE_MAINNET_DEMO_PROVIDER_ADDRESS=
VITE_MAINNET_DEMO_CONNECTOR_ADDRESS=

# Demo-only settlement token address.
# This is not Circle-issued USDC. It is a SEP-41 testnet token deployed for
# the SCF #42 Tranche 2 demo because public testnet liquidity was empty after
# reset. Escrow still demonstrates standardized settlement.
VITE_USDC_TOKEN_ADDRESS=CAHJQG77XDPFZAC7JJSRGAVYWKGEUDWOQ5O33VK4VTR2ZKOBCZAIVLFX
VITE_SETTLEMENT_TOKEN_SYMBOL=USDC
VITE_SETTLEMENT_TOKEN_NAME=Stellar USDC
VITE_SETTLEMENT_TOKEN_DECIMALS=7
VITE_SETTLEMENT_MIN_UNITS=1
VITE_SETTLEMENT_ASSET_POLICY=demo-testnet
VITE_STELLAR_BROKER_PROVIDER=testnet-soroswap-seeded
VITE_STELLAR_BROKER_SLIPPAGE_BPS=100
VITE_STELLAR_BROKER_QUOTE_TTL_SECONDS=3600

# Soroswap testnet AMM router. The D6 swap calls this contract directly
# against the seeded XLM/demo-settlement-token pool.
VITE_SOROSWAP_ROUTER_ADDRESS=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD

# Seeded Soroswap XLM/demo-settlement-token pool used by the demo route.
VITE_SOROSWAP_POOL_ADDRESS=CA4ASYDOCOJXZFB3H7O6QJ5PTDAMXORCRZN5HNE3KI7TBGS5PGR53XZ5

# Optional public REST aggregator check. This belongs on the backend, not in a
# VITE_ variable, because Vite variables are visible in browser JavaScript.
SOROSWAP_API_KEY=

# Privy fiat onramp top-up. This buys crypto into a source wallet first; it
# does not directly lock Stellar escrow funds. The default route buys Base USDC,
# then the user can route/top up into Stellar through Add Funds from Another Chain.
VITE_PRIVY_FIAT_ONRAMP_ENABLED=true
VITE_PRIVY_FIAT_ONRAMP_ENVIRONMENT=sandbox
VITE_PRIVY_FIAT_ONRAMP_DESTINATION_CHAIN=eip155:8453
VITE_PRIVY_FIAT_ONRAMP_DESTINATION_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VITE_PRIVY_FIAT_ONRAMP_DEFAULT_AMOUNT=50
VITE_PRIVY_FIAT_ONRAMP_SOURCE_ASSETS=usd,eur,gbp
VITE_PRIVY_FIAT_ONRAMP_DEFAULT_SOURCE_ASSET=usd
